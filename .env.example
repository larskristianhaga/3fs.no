# Copy to .env.local and fill in. All are optional for local development.

# The site's own address (canonical URLs, sitemap, robots, JSON-LD). Defaults to https://3fs.vercel.app.
NEXT_PUBLIC_BASE_URL=

# Contact form email (Resend). Without it, form submissions return an error.
RESEND_API_KEY=

# PostHog analytics. Without these, analytics and error capture are disabled.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
