# Copy to .env and fill in. All are optional for local development.

# The site's own address (canonical URLs, sitemap, robots, JSON-LD). Defaults to https://3fs.vercel.app.
# Read at build time, so set it where the site is built.
PUBLIC_BASE_URL=

# Contact form email (Resend). Read by the server at runtime. Without it, form submissions return an error.
RESEND_API_KEY=

# PostHog analytics. Read at build time. Without these, analytics and error capture are disabled.
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=
