---
import {Image} from 'astro:assets'
import logo from '@/assets/images/logo.png'
import {siteText} from '@/content/text'
import {colors} from '@/config/colors'
import {companyInfo} from '@/config/company'
import {cn} from '@/lib/utils'

const {brand} = colors

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/'
const isActive = (path: string) => pathname === path

const navLinks = [
    {href: '/tjenester', label: siteText.header.nav.services},
    {href: '/trefelling-pris', label: siteText.header.nav.pricing},
    {href: '/om-oss', label: siteText.header.nav.about},
    {href: '/faq', label: siteText.header.nav.faq},
    {href: '/kontakt-oss', label: siteText.header.nav.contact},
]

const phoneClass = 'flex items-center gap-2 px-4 py-2.5 rounded-full font-semibold text-[15px] no-underline transition-colors'
---
<header class={cn('sticky top-0 z-50 backdrop-blur-md border-b', brand.background.creamTranslucent, brand.border.inkSubtle, brand.text.ink)}>
    <div class="max-w-[1280px] mx-auto px-6 py-3 flex items-center gap-6">
        <a href="/" class={cn('flex items-center gap-2.5 mr-auto no-underline', brand.text.ink)} aria-label={siteText.header.aria.logo}>
            <Image src={logo} alt="" width={40} height={40} class="w-10 h-10 object-contain" loading="eager" quality={75} />
            <span class="font-heading stretch-semi-condensed font-extrabold text-lg sm:text-xl tracking-[.01em] uppercase">
                {companyInfo.name.replace(/ AS$/, '')}
            </span>
        </a>

        <nav class="hidden lg:flex gap-[22px] text-[15px] font-medium" aria-label={siteText.header.aria.nav}>
            {navLinks.map((link) => (
                <a
                    href={link.href}
                    aria-current={isActive(link.href) ? 'page' : undefined}
                    data-capture={link.href === '/kontakt-oss' ? 'contact_page_cta_clicked' : undefined}
                    data-capture-placement={link.href === '/kontakt-oss' ? 'header_desktop' : undefined}
                    class={cn(
                        'no-underline underline-offset-[6px] decoration-2 transition-colors',
                        brand.hover.text.emberDark,
                        isActive(link.href) && 'underline decoration-ember',
                    )}
                >
                    {link.label}
                </a>
            ))}
        </nav>

        <a
            href={`tel:${companyInfo.contact.phone.href}`}
            data-capture="contact_phone_clicked"
            data-capture-placement="header_desktop"
            class={cn(phoneClass, 'hidden sm:flex', brand.background.ink, brand.text.cream, brand.focus.outline)}
        >
            {siteText.header.callUs} {companyInfo.contact.phone.display}
        </a>

        <div class="lg:hidden">
            <button
                type="button"
                data-menu-open
                aria-label={siteText.header.aria.menuOpen}
                aria-haspopup="dialog"
                aria-expanded="false"
                class={cn('grid place-items-center w-11 h-11 rounded-full border-[1.5px]', brand.border.ink, brand.focus.outline)}
            >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>

            <dialog
                data-menu
                aria-label={siteText.header.aria.nav}
                class={cn('fixed inset-y-0 right-0 left-auto m-0 h-full max-h-none w-[300px] max-w-[85vw] sm:w-[384px] border-l p-0 shadow-lg backdrop:bg-black/80', brand.background.cream, brand.text.ink, brand.border.inkSubtle)}
            >
                <div class="relative h-full p-6">
                    <button
                        type="button"
                        data-menu-close
                        class={cn('absolute right-4 top-4 rounded-sm opacity-70 transition-opacity hover:opacity-100', brand.focus.outline)}
                    >
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M18 6 6 18M6 6l12 12" />
                        </svg>
                        <span class="sr-only">{siteText.header.aria.menuClose}</span>
                    </button>

                    <nav class="flex flex-col gap-1 mt-8 px-4" aria-label={siteText.header.aria.nav}>
                        {navLinks.map((link) => (
                            <a
                                href={link.href}
                                aria-current={isActive(link.href) ? 'page' : undefined}
                                data-capture={link.href === '/kontakt-oss' ? 'contact_page_cta_clicked' : undefined}
                                data-capture-placement={link.href === '/kontakt-oss' ? 'header_mobile' : undefined}
                                class={cn(
                                    'py-3 border-b font-heading stretch-semi-condensed font-extrabold text-2xl uppercase no-underline',
                                    brand.border.inkSubtle,
                                    isActive(link.href) ? brand.text.emberDark : brand.text.ink,
                                )}
                            >
                                {link.label}
                            </a>
                        ))}
                        <a
                            href={`tel:${companyInfo.contact.phone.href}`}
                            data-capture="contact_phone_clicked"
                            data-capture-placement="header_mobile"
                            class={cn(phoneClass, 'mt-6 justify-center', brand.background.ink, brand.text.cream, brand.focus.outline)}
                        >
                            {siteText.header.callUs} {companyInfo.contact.phone.display}
                        </a>
                    </nav>
                </div>
            </dialog>
        </div>
    </div>
</header>

<script>
    const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]')
    const dialog = document.querySelector<HTMLDialogElement>('dialog[data-menu]')

    if (openButton && dialog) {
        openButton.addEventListener('click', () => {
            dialog.showModal()
            openButton.setAttribute('aria-expanded', 'true')
        })

        // Escape, the close button, a tap on the backdrop or on a link all end up here
        dialog.addEventListener('close', () => openButton.setAttribute('aria-expanded', 'false'))
        dialog.addEventListener('click', (event) => {
            const target = event.target as HTMLElement
            if (target === dialog || target.closest('[data-menu-close], a')) {
                dialog.close()
            }
        })
    }
</script>
