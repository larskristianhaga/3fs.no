---
import {Image} from 'astro:assets'
import AreaLinks from '@/components/AreaLinks.astro'
import BreadcrumbSchema from '@/components/BreadcrumbSchema.astro'
import CtaBand from '@/components/CtaBand.astro'
import PageHero from '@/components/PageHero.astro'
import ServiceSchema from '@/components/ServiceSchema.astro'
import {colors} from '@/config/colors'
import {companyInfo} from '@/config/company'
import {siteText} from '@/content/text'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {imageFor} from '@/lib/images'
import {styles} from '@/lib/styles'
import {cn} from '@/lib/utils'

const {brand} = colors
---
<BaseLayout
    title="Trefelling tjenester | Erfarne trefellere i Oslo og Akershus"
    description="Profesjonelle trefellere for trefelling, stubbefresing, beskjæring, tomterydding og flishugging i Oslo, Akershus, Østfold og Buskerud."
    keywords="trefelling, trefellere, stubbefresing, stubbefjerning oslo, beskjæring, tomterydding, flishugging, trefelling oslo, trefelling follo, trepleie, arborist"
    path="/tjenester"
    ogTitle="Trefelling tjenester | Erfarne trefellere"
    ogDescription="Komplette trefellingstjenester: felling, stubbefresing, beskjæring og opprydding."
    ogImageAlt="Trefellingsspesialisten AS - Trefellingstjenester"
>
    <BreadcrumbSchema
        items={[
            {name: 'Forside', url: companyInfo.website},
            {name: 'Tjenester', url: `${companyInfo.website}/tjenester`},
        ]}
    />
    {siteText.services.items.map((service) => (
        <ServiceSchema serviceName={service.title} serviceDescription={service.description} />
    ))}

    <PageHero title={siteText.services.title} intro={siteText.home.servicesSection.subtitle} />

    <section class={cn(styles.container, 'pb-20')}>
        <div class={cn('flex flex-col', styles.ruleTop)}>
            {siteText.services.items.map((service, index) => (
                <article
                    id={service.id}
                    class={cn('scroll-mt-[90px] py-12 border-b grid grid-cols-1 lg:grid-cols-2 gap-10 items-center', brand.border.inkSubtle)}
                >
                    <div class={cn('relative aspect-[4/3] rounded-md overflow-hidden', brand.background.sandDark, index % 2 === 1 && 'lg:order-2')}>
                        <Image
                            src={imageFor(`/images/tjenester/${service.id}.jpg`)}
                            alt={service.imageAlt || service.title}
                            widths={[640, 1000, 1240]}
                            sizes="(max-width: 1024px) 100vw, 620px"
                            format="webp"
                            quality={80}
                            loading={index < 2 ? 'eager' : 'lazy'}
                            fetchpriority={index < 2 ? 'high' : undefined}
                            class="absolute inset-0 w-full h-full object-cover"
                        />
                    </div>
                    <div class="flex flex-col gap-4">
                        <span class={cn('font-heading font-bold text-[15px]', brand.text.emberDark)}>
                            {String(index + 1).padStart(2, '0')}
                        </span>
                        <h2 class={styles.subHeading}>
                            <a href={`/tjenester/${service.id}`} class={cn('no-underline transition-colors', brand.hover.text.emberDark, brand.focus.outline)}>
                                {service.title}
                            </a>
                        </h2>
                        <p class={styles.body}>{service.description}</p>
                        <div class="flex flex-wrap gap-x-6 gap-y-2">
                            <a href={`/tjenester/${service.id}`} class={styles.textLink}>
                                {siteText.services.readMore} {service.title.toLowerCase()} →
                            </a>
                            <a href="/kontakt-oss" class={styles.textLink}>
                                {siteText.home.servicesSection.quoteLink} {service.title.toLowerCase()} →
                            </a>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </section>

    <section class={brand.background.sand}>
        <div class={cn(styles.container, 'py-16 flex flex-col gap-5')}>
            <h2 class={styles.subHeading}>{siteText.common.areasTitle}</h2>
            <p class={styles.body}>{siteText.common.areasText}</p>
            <AreaLinks />
            <a href="/trefelling-pris" class={cn(styles.textLink, 'self-start')}>
                {siteText.common.pricingGuide}
            </a>
        </div>
    </section>

    <CtaBand title={siteText.common.servicesCtaTitle} text={siteText.common.servicesCtaText} />
</BaseLayout>
