---
import {Image, getImage} from 'astro:assets'
import ContactDetails from '@/components/ContactDetails.astro'
import ContactForm from '@/components/ContactForm'
import Eyebrow from '@/components/Eyebrow.astro'
import ServicesShowcase from '@/components/ServicesShowcase'
import {colors} from '@/config/colors'
import {companyInfo} from '@/config/company'
import {siteText} from '@/content/text'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {imageFor} from '@/lib/images'
import {styles} from '@/lib/styles'
import {cn} from '@/lib/utils'

const {brand} = colors
const home = siteText.home
const {container, sectionHeading, primaryButton, outlineButton, displayHeading} = styles

// The photos of the services list are optimised here because the list is an interactive React island
const serviceImages = await Promise.all(
    home.servicesSection.items.map(async (item) => {
        const image = await getImage({src: imageFor(`/images/tjenester/${item.id}.jpg`), widths: [600, 1000], width: 1000, format: 'webp', quality: 75})
        return {src: image.src, srcSet: image.srcSet.attribute}
    }),
)
---
<BaseLayout
    fullTitle="Trefelling i Oslo og Akershus | Erfarne trefellere | Trefellingsspesialisten AS"
    description="Erfarne trefellere for trygg trefelling, beskjæring og stubbefresing i Oslo, Akershus, Østfold og Buskerud. Gratis befaring, rask respons og tydelig pris."
    keywords="trefelling, trefellere, trefeller, trepleie, arborist, beskjæring, stubbefresing, tomterydding, Oslo, Akershus, Østfold, Buskerud, Ås"
    path="/"
    ogTitle="Trefelling i Oslo og Akershus | Erfarne trefellere"
    ogDescription="Trygg trefelling, beskjæring og stubbefresing med erfarne trefellere. Gratis befaring og tydelig pristilbud."
    ogImageAlt="Trefellingsspesialisten AS - Profesjonell trefelling og beskjæring"
>
    <section class={cn(container, 'pt-14 pb-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center')}>
        <div class="flex flex-col gap-7">
            <Eyebrow class={brand.text.forest}>{home.hero.areas}</Eyebrow>
            <h1 class={cn(displayHeading, 'text-[clamp(52px,7.2vw,108px)] leading-[.9] tracking-[-.01em]')}>
                {home.hero.title} <span class={brand.text.forest}>{home.hero.titleAccent}</span>
            </h1>
            <p class={cn('m-0 max-w-[52ch] text-[19px] leading-relaxed text-pretty', brand.text.inkSoft)}>
                {home.hero.description}
            </p>
            <div class="flex gap-3 flex-wrap">
                <a href="#befaring" class={primaryButton}>{home.hero.cta}</a>
                <a href="#tjenester" class={outlineButton}>
                    {home.hero.secondaryCta}
                </a>
            </div>
        </div>
        <div class="relative min-h-[420px] lg:min-h-[520px]">
            {/* Eager but not preloaded: on phones the LCP is the heading above, and a high-priority
                preload of this photo would compete with the heading's font on a slow connection */}
            <Image
                src={imageFor('/images/beskjaert-tre.jpg')}
                alt={home.hero.imageAlt}
                widths={[640, 1000, 1240]}
                sizes="(max-width: 1024px) calc(100vw - 48px), 620px"
                format="webp"
                quality={75}
                loading="eager"
                class="absolute inset-0 w-full h-full object-cover rounded-md"
            />
            <a
                href="#forsikring"
                class={cn('absolute left-3 lg:-left-3 bottom-7 flex items-center gap-3.5 py-4 pl-4 pr-5 rounded-md shadow-[0_18px_40px_rgba(23,32,26,.25)] no-underline max-w-[320px] transition-transform hover:-translate-y-0.5', brand.background.cream, brand.text.ink, brand.focus.outline)}
            >
                <span class={cn('flex-none w-11 h-11 rounded-full grid place-items-center text-xl font-bold', brand.background.forest, brand.text.cream)} aria-hidden="true">✓</span>
                <span class="flex flex-col gap-0.5">
                    <span class="font-semibold">{home.hero.insuranceBadge.title} {companyInfo.insurance.provider}</span>
                    <span class={cn('text-sm', brand.text.inkSoft)}>
                        {home.insurance.card.coveragePrefix} {companyInfo.insurance.coverageShort} · {home.hero.insuranceBadge.linkText}
                    </span>
                </span>
            </a>
        </div>
    </section>

    <section class={cn(container, 'pb-[72px]')}>
        <ul class={cn('grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-t-[1.5px] border-b', brand.border.ink)}>
            {home.trustStrip.map((item) => (
                <li class="py-5 pr-5 flex flex-col gap-1">
                    <span class="font-semibold">{item.title}</span>
                    <span class={cn('text-[15px]', brand.text.inkMuted)}>{item.description}</span>
                </li>
            ))}
        </ul>
    </section>

    <section id="tjenester" class={cn('scroll-mt-[70px]', brand.background.sand)}>
        <div class={cn(container, 'py-[88px] flex flex-col gap-12')}>
            <div class="flex justify-between items-end gap-6 flex-wrap">
                <h2 class={sectionHeading}>{home.servicesSection.title}</h2>
                <p class={cn('m-0 max-w-[44ch] text-[17px] leading-relaxed', brand.text.inkSoft)}>
                    {home.servicesSection.subtitle}
                </p>
            </div>
            <ServicesShowcase images={serviceImages} client:visible />
            <div class="flex gap-6 flex-wrap font-semibold">
                <a href="/tjenester" class={cn('underline underline-offset-4', brand.hover.text.emberDark)}>
                    {home.servicesSection.allServicesLink}
                </a>
                <a href="/trefelling-pris" class={cn('underline underline-offset-4', brand.hover.text.emberDark)}>
                    {home.servicesSection.pricingLink}
                </a>
            </div>
        </div>
    </section>

    <section id="forsikring" class={cn('scroll-mt-[70px]', brand.background.ink, brand.text.cream)}>
        <div class={cn(container, 'py-24 grid grid-cols-1 lg:grid-cols-2 gap-14 items-center')}>
            <div class="flex flex-col gap-6">
                <Eyebrow class={brand.text.ember}>{home.insurance.eyebrow}</Eyebrow>
                <h2 class={sectionHeading}>{home.insurance.title}</h2>
                <p class={cn('m-0 max-w-[50ch] text-lg leading-relaxed', brand.text.mist)}>
                    {home.insurance.description}
                </p>
                <div class="flex gap-3 flex-wrap">
                    <a href={companyInfo.insurance.certificate} target="_blank" rel="noopener noreferrer" class={cn(primaryButton, 'text-base')}>
                        {home.insurance.openButton}
                    </a>
                </div>
            </div>
            <a
                href={companyInfo.insurance.certificate}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={home.insurance.openButton}
                class={cn('justify-self-center w-full max-w-[400px] no-underline -rotate-[2.5deg] transition-transform duration-300 hover:rotate-0 hover:-translate-y-1', brand.text.ink, brand.focus.outline)}
            >
                <div class={cn('rounded px-8 py-9 shadow-[0_30px_60px_rgba(0,0,0,.45)] flex flex-col gap-[18px] aspect-[1/1.3]', brand.background.paper)}>
                    <div class="flex justify-between items-start">
                        <span class="font-heading stretch-semi-condensed font-extrabold text-[22px] uppercase tracking-[.02em]">
                            {home.insurance.card.title}
                        </span>
                        <span class={cn('font-bold text-[22px]', brand.text.insurer)}>{companyInfo.insurance.provider}</span>
                    </div>
                    <div class={cn('h-px', brand.background.sandDark)}></div>
                    <div class="flex flex-col gap-1 text-sm">
                        <span class={brand.text.inkMuted}>{home.insurance.card.holderLabel}</span>
                        <span class="font-semibold">{companyInfo.name}</span>
                        <span>{siteText.footer.orgNumber} {companyInfo.organization.number}</span>
                    </div>
                    <div class="flex flex-col gap-1 text-sm">
                        <span class={brand.text.inkMuted}>{home.insurance.card.coverageLabel}</span>
                        <span class="font-semibold">{home.insurance.card.coverage}</span>
                        <span>{home.insurance.card.coveragePrefix} {companyInfo.insurance.coverage}</span>
                    </div>
                    <div class="flex flex-col gap-2 mt-1.5" aria-hidden="true">
                        <span class={cn('h-1.5 rounded-sm', brand.background.sand)}></span>
                        <span class={cn('h-1.5 w-[86%] rounded-sm', brand.background.sand)}></span>
                        <span class={cn('h-1.5 w-[70%] rounded-sm', brand.background.sand)}></span>
                    </div>
                    <span class={cn('mt-auto text-sm font-semibold', brand.text.emberDark)}>{home.insurance.card.cta}</span>
                </div>
            </a>
        </div>
    </section>

    <section id="om-oss" class="scroll-mt-[70px]">
        <div class={cn(container, 'py-24 grid grid-cols-1 lg:grid-cols-2 gap-14 items-center')}>
            <div class="relative aspect-[4/3]">
                <Image
                    src={imageFor('/images/om-oss/fugleperspektiv-maskiner-fra-tre.jpg')}
                    alt={home.about.imageAlt}
                    widths={[640, 1000, 1240]}
                    sizes="(max-width: 1024px) 100vw, 620px"
                    format="webp"
                    quality={75}
                    loading="lazy"
                    class="absolute inset-0 w-full h-full object-cover rounded-md"
                />
            </div>
            <div class="flex flex-col gap-[22px]">
                <h2 class={cn(displayHeading, 'text-[clamp(40px,4.6vw,68px)] leading-[.94]')}>{home.about.title}</h2>
                <p class={cn('m-0 text-[17px] leading-relaxed text-pretty', brand.text.inkSoft)}>{home.about.description}</p>
                <p class={cn('m-0 font-heading font-bold text-[22px] [font-stretch:80%]', brand.text.forest)}>{home.about.tagline}</p>
                <a href="/om-oss" class={cn('self-start font-semibold underline underline-offset-4', brand.hover.text.emberDark)}>
                    {home.about.link}
                </a>
                <dl class={cn('grid grid-cols-3 gap-5 pt-5 border-t-[1.5px] m-0', brand.border.ink)}>
                    {home.about.stats.map((stat) => (
                        <div class="flex flex-col-reverse gap-0.5">
                            <dt class={cn('text-sm', brand.text.inkMuted)}>{stat.label}</dt>
                            <dd class="m-0 font-heading font-black text-[clamp(32px,4vw,44px)] leading-none [font-stretch:70%]">{stat.value}</dd>
                        </div>
                    ))}
                </dl>
            </div>
        </div>
    </section>

    <section class={brand.background.sand}>
        <div class={cn(container, 'py-[88px] flex flex-col gap-10')}>
            <h2 class={cn(displayHeading, 'text-[clamp(40px,4.6vw,68px)] leading-[.94]')}>{home.testimonials.title}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                {home.testimonials.items.map((text) => (
                    <figure class={cn('m-0 p-7 rounded-md flex flex-col gap-5', brand.background.cream)}>
                        <blockquote class="m-0 text-[17px] leading-relaxed text-pretty">«{text}»</blockquote>
                        <figcaption class={cn('mt-auto text-sm font-semibold', brand.text.inkMuted)}>
                            {home.testimonials.attribution}
                        </figcaption>
                    </figure>
                ))}
            </div>
        </div>
    </section>

    <section id="befaring" class="scroll-mt-[70px]">
        <div class={cn(container, 'py-24 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-14 items-start')}>
            <div class="flex flex-col gap-6">
                <Eyebrow class={brand.text.emberDark}>{home.booking.eyebrow}</Eyebrow>
                <h2 class={sectionHeading}>{home.booking.title}</h2>
                <p class={cn('m-0 max-w-[44ch] text-[17px] leading-relaxed', brand.text.inkSoft)}>{home.booking.description}</p>
                <ContactDetails />
            </div>

            <div class={cn('rounded-lg p-[clamp(24px,4vw,40px)] shadow-[0_1px_0_rgba(23,32,26,.08),0_20px_50px_rgba(23,32,26,.08)]', brand.background.paper)}>
                <ContactForm client:visible />
            </div>
        </div>
    </section>
</BaseLayout>
