---
import AreaLinks from '@/components/AreaLinks.astro'
import ContactDetails from '@/components/ContactDetails.astro'
import ContactForm from '@/components/ContactForm'
import Eyebrow from '@/components/Eyebrow.astro'
import {colors} from '@/config/colors'
import {companyInfo} from '@/config/company'
import {siteText} from '@/content/text'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {styles} from '@/lib/styles'
import {cn} from '@/lib/utils'

const {brand} = colors
---
<BaseLayout
    title="Kontakt oss - Gratis befaring og pristilbud"
    description={`Kontakt ${companyInfo.name} for profesjonell trefelling, beskjæring og arboriststjenester. Gratis befaring og uforpliktende pristilbud. Ring ${companyInfo.contact.phone.display} eller send oss en melding.`}
    keywords={`kontakt trefelling, gratis befaring, pristilbud trefelling, nødtjeneste trefelling, trefelling telefonnummer, ${companyInfo.serviceAreasText}`}
    path="/kontakt-oss"
    ogTitle={`Kontakt oss - Gratis befaring og pristilbud | ${companyInfo.name}`}
    ogDescription={`Få ditt gratis pristilbud for profesjonelle trefellingstjenester. Vi betjener ${companyInfo.serviceAreasText}. Ring ${companyInfo.contact.phone.display}.`}
    ogImageAlt={`Kontakt ${companyInfo.name}`}
>
    <section class={cn(styles.container, 'pt-14 pb-24 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-14 items-start')}>
        <div class="flex flex-col gap-6">
            <Eyebrow class={brand.text.emberDark}>{siteText.home.booking.eyebrow}</Eyebrow>
            <h1 class={styles.pageTitle}>{siteText.contact.title}</h1>
            {siteText.contact.intro.map((item) => (
                <p class={styles.body}>
                    {item.paragraph}
                </p>
            ))}
            <ContactDetails />
            <div class="flex flex-col gap-3 pt-4">
                <h2 class="m-0 font-semibold text-base">{siteText.common.contactAreasTitle}</h2>
                <p class={cn(styles.muted, 'm-0')}>{siteText.common.contactAreasText}</p>
                <AreaLinks />
            </div>
        </div>

        <div class={cn('rounded-lg p-[clamp(24px,4vw,40px)] shadow-[0_1px_0_rgba(23,32,26,.08),0_20px_50px_rgba(23,32,26,.08)]', brand.background.paper)}>
            <ContactForm client:visible />
        </div>
    </section>
</BaseLayout>
